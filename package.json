{
  "name": "transcript",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:count": "vitest run --reporter=json --outputFile=.vitest-result.json && node scripts/assert-tests-ran.mjs",
    "build": "node scripts/build.mjs",
    "test:live": "vitest run --config vitest.live.config.ts",
    "verify:package": "node scripts/start-the-package.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.699.0",
    "@aws-sdk/lib-dynamodb": "^3.699.0",
    "bgutils-js": "^4.0.3",
    "jsdom": "^25.0.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.146",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.1",
    "esbuild": "^0.24.0",
    "eslint": "^9.16.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
